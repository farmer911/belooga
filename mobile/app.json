{
  "expo": {
    "name": "Belooga Mobile",
    "slug": "belooga-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "belooga",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.belooga.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Record your 60-second video elevator pitch directly in Belooga Studio.",
        "NSMicrophoneUsageDescription": "Capture clear voice audio for your 60-second video elevator pitch."
      }
    },
    "android": {
      "package": "com.belooga.mobile",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-camera"]
  }
}
