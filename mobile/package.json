{
  "name": "belooga-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:apk": "bash scripts/build-apk.sh",
    "test:e2e:android": "bash scripts/e2e-mobile-adb.sh",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testTimeout": 60000,
    "roots": [
      "<rootDir>/tests"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "expo": "~58.0.20",
    "expo-camera": "~58.0.13",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.1",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
