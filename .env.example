# ==============================================================================
# Belooga Platform - Environment Configuration Template (.env.example)
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Infrastructure - PostgreSQL Database
# ------------------------------------------------------------------------------
# Standard Docker container credentials
POSTGRES_USER=belooga
POSTGRES_PASSWORD=belooga_secret_password
POSTGRES_DB=belooga_db

# When running backend locally (connecting to host-mapped Docker Postgres port 5433):
DATABASE_URL=postgresql+asyncpg://belooga:belooga_secret_password@localhost:5433/belooga_db

# Test database URL (used by pytest hermetic test runner):
TEST_DATABASE_URL=postgresql+asyncpg://belooga:belooga_secret_password@localhost:5433/belooga_test

# When running backend inside Docker Compose network:
# DATABASE_URL=postgresql+asyncpg://belooga:belooga_secret_password@postgres:5432/belooga_db

# ------------------------------------------------------------------------------
# 2. Infrastructure - Redis Cache
# ------------------------------------------------------------------------------
# Host-mapped port 6379:
REDIS_URL=redis://localhost:6379/0

# When running inside Docker Compose:
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
JWT_SECRET=dev_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (comma-separated list for backend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base upload directory for avatars, resumes, videos, and chunks
UPLOAD_DIR=/tmp/belooga_uploads

# ------------------------------------------------------------------------------
# 4. Frontend Service Configuration (Next.js 16)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to 1 to enable E2E testing hooks (e.g. teleprompter fake voice activity)
NEXT_PUBLIC_E2E=0

# ------------------------------------------------------------------------------
# 5. Quality Control & E2E Testing (Playwright)
# ------------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://localhost:3000
CI=false

# ------------------------------------------------------------------------------
# 6. Legacy Parity & Asset Extraction
# ------------------------------------------------------------------------------
LEGACY_DIR=../Beloga-CV

