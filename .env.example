# ==============================================================================
# Belooga Platform - Environment Configuration Template (.env.example)
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Infrastructure - PostgreSQL Database
# ------------------------------------------------------------------------------
# Standard Docker container credentials
POSTGRES_USER=belooga
POSTGRES_PASSWORD=belooga_secret_password
POSTGRES_DB=belooga_db

# When running backend locally (connecting to host-mapped Docker Postgres port 5433):
DATABASE_URL=postgresql+asyncpg://belooga:belooga_secret_password@localhost:5433/belooga_db

# Test database URL (used by pytest hermetic test runner):
TEST_DATABASE_URL=postgresql+asyncpg://belooga:belooga_secret_password@localhost:5433/belooga_test

# SQLAlchemy Async Engine Connection Pool Tuning:
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=60
DB_POOL_TIMEOUT=30

# When running backend inside Docker Compose network:
# DATABASE_URL=postgresql+asyncpg://belooga:belooga_secret_password@postgres:5432/belooga_db

# ------------------------------------------------------------------------------
# 2. Infrastructure - Redis Cache
# ------------------------------------------------------------------------------
# Host-mapped port 6379:
REDIS_URL=redis://localhost:6379/0
GATEWAY_REDIS_ENABLED=1

# When running inside Docker Compose:
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
JWT_SECRET=dev_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (comma-separated list for backend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
PUBLIC_API_URL=http://localhost:8080

# Base upload directory for avatars, resumes, videos, and chunks
UPLOAD_DIR=/tmp/belooga_uploads

# MoMo Payment Gateway HMAC-SHA256 Secret Key (Required in production)
MOMO_SECRET_KEY=belooga_momo_secret_key_mock_hmac

# Google OAuth (authorization code flow). Leave empty to disable Google sign-in (callback returns 503).
# Authorized redirect URI in Google Cloud Console: <FRONTEND_URL>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional Email / SMTP Notification Settings
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@belooga.com

# ------------------------------------------------------------------------------
# 4. Frontend & Mobile Service Configuration (Next.js 16 & Expo React Native)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=https://belooga.com
# Same value as GOOGLE_CLIENT_ID; empty hides the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_API_URL=http://localhost:8080
# Set to 1 to enable E2E testing hooks (e.g. teleprompter fake voice activity)
NEXT_PUBLIC_E2E=0

# ------------------------------------------------------------------------------
# 5. Quality Control & E2E Testing (Playwright)
# ------------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://localhost:3000
CI=false

# ------------------------------------------------------------------------------
# 6. Legacy Parity & Asset Extraction
# ------------------------------------------------------------------------------
# Optional upstream legacy checkout; when unset, agents use the in-repo read-only legacy/ directory.
LEGACY_DIR=legacy

